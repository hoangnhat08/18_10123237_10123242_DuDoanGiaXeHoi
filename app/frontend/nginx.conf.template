server {
    listen 80;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    # Proxy API ve Backend qua ten service trong Docker network (khong hardcode IP/localhost)
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header X-Request-ID $http_x_request_id;
    }
}
